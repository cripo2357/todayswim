# Firebase web SDK (@firebase/auth, @react-native-firebase/app transitive) 가
# @react-native-async-storage/async-storage ^1.18.1 을 peer dep 으로 요구하는데
# 우리는 2.2.0 을 직접 의존성으로 명시한다(Expo SDK 55 정합). 두 메이저 범위
# 가 안 맞아서 npm ci(EAS Build 의 strict mode) 가 "Missing 1.x.x from lock
# file" 로 거절한다.
#
# 우리는 firebase web SDK 의 auth 를 쓰지 않고 @react-native-firebase 네이티브
# SDK 만 쓰므로 dead-code path 의 peer 요구를 무시해도 무해. legacy-peer-deps
# 로 npm 7+ peer enforcement 를 끄고 dedupe 결과를 그대로 받는다.
#
# (참고: overrides 만으로는 EAS Build 의 npm ci 가 거절 — npm config 레벨에서
# enforcement 자체를 비활성화해야 npm ci 통과.)
legacy-peer-deps=true
