# Pool's day 환경변수
# 실제 키는 `.env`에 (gitignored). 이 파일은 키 종류만 알려주는 템플릿.
# Expo SDK 55+의 `EXPO_PUBLIC_*` prefix는 빌드 타임에 JS 번들에 인라인됨.

# Supabase
# Dashboard → Project Settings → API
# URL: 프로젝트 URL (예: https://xxxxx.supabase.co)
# ANON KEY: anon public 키 (JWT 형식, eyJ로 시작). 모바일 앱에 노출 OK (RLS로 보호).
# 서비스 롤 키는 절대 모바일 앱에 넣지 마 — 서버 전용.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Naver Maps Client ID — 모바일 SDK 인증.
# 번들 ID(com.cripo.poolsday)로 Naver 콘솔에서 제한돼 있어 노출 OK.
# Client Secret은 절대 여기 X — Geocoding 등 server API는 별도 백엔드(Supabase Edge Function)로.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=your-naver-map-client-id

# (Phase 2) 백엔드 API
# EXPO_PUBLIC_API_BASE_URL=
